#========= 全局配置 ========#
mode: rule      # 工作模式  rule（规则模式）/ global（全局模式）/ direct（直连模式）
redir-mode: tproxy
log-level: warning        # 日志级别  silent（静默）/ error（错误）/ warning（警告）/ info（信息）/ debug（调试）
ipv6: false              # 开启 IPv6 支持
etag-support: true         
disable-keep-alive: false       # 开启长连接
find-process-mode: always        # 进程匹配模式    
global-client-fingerprint: chrome
unified-delay: true              # 开启统一延迟 (计算 HTTP 响应时间)
tcp-concurrent: true            # 开启 TCP 并发连接
inbound-tfo: true
inbound-mptcp: false
udp-fallback-policy: slowest
allow-lan: true              # 局域连接  是否允许局域网设备连接
keep-alive-idle: 300         # TCP 空闲等待 
keep-alive-interval: 30            # TCP 保活间隔
bind-address: "*"           # 监听接口  监听的网络接口（* 表示所有接口）

# 认证配置
